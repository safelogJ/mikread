<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- При нажатии -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/winbox_btn_down"/>
            <stroke android:width="1dp" android:color="@color/winbox_btn_border_down"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>

    <!-- Обычное состояние -->
    <item>
        <shape>
            <solid android:color="@color/main_background"/>
            <stroke android:width="0.7dp" android:color="@color/winbox_btn_border_up"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</selector>